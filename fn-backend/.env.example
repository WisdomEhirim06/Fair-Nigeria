NODE_ENV=development
PORT=3000
LOG_LEVEL=info

CORS_ORIGINS=

DATABASE_URL=postgresql://postgres:<password>@localhost:5432/fn_app
AUTH_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/fn_auth

# Redis (Docker)
REDIS_URL=redis://localhost:6379

# RS256 keypair for access tokens. Paste either a full PEM (with \n) or a
# base64-encoded PEM. Generate a dev keypair with openssl:
#   openssl genpkey -algorithm RSA -pkcs8 -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# Then base64-encode each (one line) and paste below:
#   base64 -w0 private.pem   (Git Bash / Linux)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

FCM_SERVICE_ACCOUNT_B64=

OTP_SMS_API_KEY=

# Number of flags before a sheet automatically moves to under_review.
FLAG_THRESHOLD=5
