{
  "name": "fn-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fair Nigeria backend - modular monolith API (Node.js + Express 5 + TypeScript).",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate:app": "drizzle-kit generate --config=drizzle.app.config.ts",
    "db:migrate:app": "drizzle-kit migrate --config=drizzle.app.config.ts",
    "db:studio:app": "drizzle-kit studio --config=drizzle.app.config.ts",
    "db:generate:auth": "drizzle-kit generate --config=drizzle.auth.config.ts",
    "db:migrate:auth": "drizzle-kit migrate --config=drizzle.auth.config.ts",
    "db:studio:auth": "drizzle-kit studio --config=drizzle.auth.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
